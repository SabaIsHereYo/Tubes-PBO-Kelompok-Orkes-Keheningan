<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.focuspulse.controllers.MainController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      <Label styleClass="app-title" text="FOCUSPULSE" />
      
      <VBox alignment="CENTER" spacing="15.0" styleClass="card">
         <children>
            <Label fx:id="timerLabel" styleClass="timer-display" text="25:00" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="startBtn" styleClass="btn-primary" text="Start" />
                  <Button fx:id="pauseBtn" styleClass="btn-warning" text="Pause" />
                  <Button fx:id="resetBtn" styleClass="btn-danger" text="Reset" />
               </children>
            </HBox>
         </children>
      </VBox>
      
      <Label styleClass="section-title" text="Ambient Sound Mixer" />
      
      <VBox spacing="14.0" styleClass="card">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="110.0" styleClass="sound-label" text="Hujan 🌧️" />
                  <Slider fx:id="rainSlider" max="1.0" min="0.0" prefWidth="200.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="110.0" styleClass="sound-label" text="Api Unggun 🔥" />
                  <Slider fx:id="fireSlider" max="1.0" min="0.0" prefWidth="200.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="110.0" styleClass="sound-label" text="Angin 🍃" />
                  <Slider fx:id="windSlider" max="1.0" min="0.0" prefWidth="200.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="browseBtn" prefWidth="110.0" styleClass="btn-primary" text="📁 Custom MP3" />
                  <Slider fx:id="customSlider" max="1.0" min="0.0" prefWidth="200.0" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>